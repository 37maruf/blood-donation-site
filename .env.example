# Copy to .env for local use. NEVER commit .env.
DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Local PostgreSQL (or set DATABASE_URL instead, e.g. for production / Vercel)
DB_NAME=blood_donatio_site
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Email (any Django backend; console by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Surjotori <no-reply@example.org>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Media storage (S3-compatible). Leave empty to use local ./media in development.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Production only
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
CRON_SECRET=
SENTRY_DSN=
